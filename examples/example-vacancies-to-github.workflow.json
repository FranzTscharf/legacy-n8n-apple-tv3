{
  "name": "Example - Vacancies JSON to GitHub",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyWeek",
              "hour": 9,
              "minute": 0,
              "weekday": "1"
            }
          ]
        }
      },
      "name": "Weekly Monday 09:00",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 120],
      "notes": "Automatically starts the workflow every Monday at 09:00 Europe/Rome."
    },
    {
      "parameters": {
        "authentication": "none",
        "requestMethod": "GET",
        "url": "https://ghr-auth.azurewebsites.net/api2/api/vacancies",
        "responseFormat": "file",
        "dataPropertyName": "data",
        "options": {
          "timeout": 60000
        }
      },
      "name": "Fetch Vacancies JSON",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [500, 300],
      "notes": "Downloads the API response as raw JSON bytes in binary property 'data'."
    },
    {
      "parameters": {
        "fileName": "/tmp/vacancies.json",
        "dataPropertyName": "data"
      },
      "name": "Write Temp JSON",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [770, 300],
      "notes": "Writes the downloaded response to /tmp/vacancies.json on the Apple TV. /tmp is temporary and may be cleared after a restart."
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "resource": "file",
        "operation": "create",
        "owner": "YOUR_GITHUB_OWNER",
        "repository": "YOUR_GITHUB_REPOSITORY",
        "filePath": "=job-postings/vacancies_{{new Date().toISOString().slice(0,10)}}.json",
        "binaryData": true,
        "binaryPropertyName": "data",
        "commitMessage": "Update vacancies.json from GHR API",
        "additionalParameters": {
          "branch": {
            "branch": "main"
          }
        }
      },
      "name": "Push JSON to GitHub",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [1040, 300],
      "credentials": {
        "githubApi": "SELECT_A_GITHUB_CREDENTIAL"
      },
      "notes": "Select a least-privilege GitHub credential and replace the owner/repository placeholders before activation. Creates a dated job-postings/vacancies_YYYY-MM-DD.json snapshot."
    }
  ],
  "connections": {
    "Start": {
      "main": [[{"node": "Fetch Vacancies JSON", "type": "main", "index": 0}]]
    },
    "Weekly Monday 09:00": {
      "main": [[{"node": "Fetch Vacancies JSON", "type": "main", "index": 0}]]
    },
    "Fetch Vacancies JSON": {
      "main": [[{"node": "Write Temp JSON", "type": "main", "index": 0}]]
    },
    "Write Temp JSON": {
      "main": [[{"node": "Push JSON to GitHub", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "timezone": "Europe/Rome"
  }
}
