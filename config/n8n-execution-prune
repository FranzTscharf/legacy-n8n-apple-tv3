#!/bin/sh
set -eu

DB='/var/local/n8n-data/.n8n/database.sqlite'

if [ ! -f "$DB" ]; then
  echo "database missing: $DB" >&2
  exit 1
fi

/usr/bin/sqlite3 "$DB" <<'SQL'
PRAGMA busy_timeout = 30000;
BEGIN IMMEDIATE;
DELETE FROM execution_entity
WHERE startedAt < datetime('now', '-7 days')
   OR (finished = 0 AND startedAt < datetime('now', '-24 hours'));
DELETE FROM execution_entity
WHERE id NOT IN (
  SELECT id FROM execution_entity ORDER BY id DESC LIMIT 100
);
COMMIT;
PRAGMA integrity_check;
SQL

