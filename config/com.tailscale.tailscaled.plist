<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tailscale.tailscaled</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/local/tailscale/bin/tailscaled-start</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>_MSSafeMode</key>
        <string>1</string>
        <key>DYLD_INSERT_LIBRARIES</key>
        <string></string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/var/local/tailscale/tailscaled.log</string>
    <key>StandardErrorPath</key>
    <string>/var/local/tailscale/tailscaled-error.log</string>
</dict>
</plist>
