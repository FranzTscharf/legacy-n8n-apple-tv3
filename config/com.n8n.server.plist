<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.n8n.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/local/n8n-runtime/bin/n8n-start</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/var/local/n8n-runtime</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>_MSSafeMode</key>
        <string>1</string>
        <key>DYLD_INSERT_LIBRARIES</key>
        <string></string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/var/local/n8n-data/n8n.log</string>
    <key>StandardErrorPath</key>
    <string>/var/local/n8n-data/n8n-error.log</string>
</dict>
</plist>
